# Copy this file to a secure staging env path and fill endpoint/secret values
# from the company secret store. Do not commit the filled file.

REQ_TRACKER_ENV=staging
DATASOURCE_MODE=jira

# Production persistence modes.
STATE_STORE=postgres
POSTGRES_DSN=
POSTGRES_TEST_DSN=

GRAPH_BACKEND=neo4j
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_TEST_URI=

VECTOR_BACKEND=qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=rune_chunks
QDRANT_VECTOR_SIZE=64
QDRANT_TEST_URL=

# Company model gateway.
MODEL_GATEWAY_MODE=http_json
MODEL_GATEWAY_ENDPOINT_URL=
MODEL_GATEWAY_API_KEY=
MODEL_GATEWAY_PROVIDER=internal
MODEL_GATEWAY_PROFILE_ID=company-sandbox
MODEL_GATEWAY_MODEL_NAME=company-sandbox-model
MODEL_GATEWAY_PROMPT_VERSION_ID=pv_company_probe
MODEL_GATEWAY_TIMEOUT_SECONDS=30
MODEL_GATEWAY_REHEARSAL_ARTIFACT_ROOT=
MODEL_PROFILES_PATH=config/model_profiles.example.json
PROMPT_VERSIONS_PATH=config/prompt_versions.example.json

# Auth is expected to run behind a company-controlled trusted proxy.
AUTH_MODE=trusted_proxy
API_KEY=
TRUSTED_PROXY_SECRET=
TRUSTED_DEFAULT_ROLE=viewer
TRUSTED_GROUP_ROLE_MAP={"rune-viewers":"viewer","rune-developers":"developer","rune-operators":"operator","rune-admins":"admin"}

# Artifact/debug storage and observability.
DEPLOYMENT_TARGET=ubuntu
KUBERNETES_DEPLOYMENT=false
ARTIFACT_STORE=local
ARTIFACT_ROOT=/var/lib/rune-agent/artifacts
LOG_LEVEL=INFO
ENABLE_DOCS=false
AUDIT_RETENTION_DAYS=365
AUDIT_MAX_EVENTS=100000
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
PROMETHEUS_BASE_URL=
GRAFANA_DASHBOARD_UID=

# Company source rehearsal configuration.
RUNE_API_BASE_URL=
RUNE_PROJECT_KEY=RUNE_CAM_ALPHA
JIRA_BASE_URL=
JIRA_TOKEN=
JIRA_PROJECT_KEY=RUNE_CAM_ALPHA
JIRA_JQL=
JIRA_REHEARSAL_LIMIT=10
CONFLUENCE_BASE_URL=
CONFLUENCE_TOKEN=
CONFLUENCE_PROJECT_KEY=RUNE_CAM_ALPHA
CONFLUENCE_SPACE_KEY=
CONFLUENCE_CQL=
CONFLUENCE_REHEARSAL_LIMIT=10
RUNE_EMAIL_EXPORT_PATH=
RUNE_EMAIL_EXPORT_LIMIT=50

# Backup/load rehearsal configuration.
BACKUP_ROOT=

# Periodic analysis scheduler. Keep disabled until the staging API is reviewed.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=3600
SCHEDULER_PROJECT_KEY=RUNE_CAM_ALPHA
SCHEDULER_SCENARIO=RUNE_MULTI_SOURCE
