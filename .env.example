REQ_TRACKER_ENV=local
DATASOURCE_MODE=dummy
GRAPH_BACKEND=memory
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
VECTOR_BACKEND=memory
MODEL_GATEWAY_MODE=dummy
ARTIFACT_STORE=local
ARTIFACT_ROOT=.local_artifacts
STATE_STORE=memory
SQLITE_STATE_PATH=.local_state/rune_state.sqlite3
POSTGRES_DSN=
LOG_LEVEL=INFO
ENABLE_DOCS=true

# Periodic analysis scheduler.
# Keep disabled for local development unless you explicitly want interval runs.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=3600
SCHEDULER_PROJECT_KEY=RUNE_CAM_ALPHA
SCHEDULER_SCENARIO=RUNE_MULTI_SOURCE
