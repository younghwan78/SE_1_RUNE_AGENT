MODEL_GATEWAY_PROMPT_VERSION_ID=pv_company_probe
MODEL_GATEWAY_TIMEOUT_SECONDS=30
MODEL_GATEWAY_REHEARSAL_ARTIFACT_ROOT=
MODEL_PROFILES_PATH=config/model_profiles.example.json
PROMPT_VERSIONS_PATH=config/prompt_versions.example.json
ARTIFACT_STORE=local
ARTIFACT_ROOT=.local_artifacts
STATE_STORE=memory
SQLITE_STATE_PATH=.local_state/rune_state.sqlite3
POSTGRES_DSN=
POSTGRES_MIGRATION_PROFILE=core
POSTGRES_TEST_DSN=
LOG_LEVEL=INFO
ENABLE_DOCS=true

# Company/staging graph, vector, and observability rehearsals.
NEO4J_TEST_URI=
QDRANT_TEST_URL=
RUNE_API_BASE_URL=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true

# Company/staging source rehearsal configuration. Keep tokens in a secret store.
RUNE_PROJECT_KEY=RUNE_CAM_ALPHA
JIRA_BASE_URL=
JIRA_TOKEN=
JIRA_PROJECT_KEY=RUNE_CAM_ALPHA
JIRA_JQL=
JIRA_REHEARSAL_LIMIT=10
CONFLUENCE_BASE_URL=
CONFLUENCE_TOKEN=
CONFLUENCE_PROJECT_KEY=RUNE_CAM_ALPHA
CONFLUENCE_SPACE_KEY=
CONFLUENCE_CQL=
CONFLUENCE_REHEARSAL_LIMIT=10
RUNE_EMAIL_EXPORT_PATH=
RUNE_EMAIL_EXPORT_LIMIT=50

# Periodic analysis scheduler.
# Keep disabled for local development unless you explicitly want interval runs.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=3600
SCHEDULER_PROJECT_KEY=RUNE_CAM_ALPHA
SCHEDULER_SCENARIO=RUNE_MULTI_SOURCE
